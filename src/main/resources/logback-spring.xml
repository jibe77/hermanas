<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom Logback configuration for Hermanas.

  Goals:
    1. Keep Spring Boot's default console output unchanged for every logger except
       the two audit-only loggers (CONFIG_AUDIT and AUDIT).
    2. Route CONFIG_AUDIT to `audit_config.txt` next to the running JAR, so
       operators can quickly review who changed which configuration knob.
    3. Route AUDIT (the existing @AuditLog AOP aspect) to `audit.txt` for
       security-sensitive operations (door open/close, shutdown, reboot).
    4. Use additivity=false on the audit loggers so audit lines do NOT also
       show up in the noisy console / spring log.
-->
<configuration>

    <!-- Inherit Spring Boot's default console + file appenders.
         file-appender.xml resolves LOG_FILE from `logging.file.name` /
         `logging.file.path` (set via systemd on the Pi -> /home/pi/log/spring.log)
         and reinstates the daily rolling policy `spring.log.YYYY-MM-DD.N.gz`. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>

    <!-- Resolve the audit log directory from the property, default = current working dir.
         Use -Dhermanas.audit.dir=/var/log/hermanas on the Pi to put the audit files
         alongside other system logs. -->
    <property name="HERMANAS_AUDIT_DIR" value="${hermanas.audit.dir:-.}"/>

    <!-- Plain text appender for configuration changes -->
    <appender name="CONFIG_AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${HERMANAS_AUDIT_DIR}/audit_config.txt</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${HERMANAS_AUDIT_DIR}/audit_config.%d{yyyy-MM}.txt</fileNamePattern>
            <!-- Keep 24 months of monthly rollovers; small file, low Pi disk pressure. -->
            <maxHistory>24</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Plain text appender for the security audit trail (door, shutdown, etc.) -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${HERMANAS_AUDIT_DIR}/audit.txt</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${HERMANAS_AUDIT_DIR}/audit.%d{yyyy-MM}.txt</fileNamePattern>
            <maxHistory>24</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %msg%n</pattern>
        </encoder>
    </appender>

    <!-- CONFIG_AUDIT is the dedicated logger used by ConfigService.setConfigValue.
         additivity=false keeps audit lines out of the main Spring log. -->
    <logger name="CONFIG_AUDIT" level="INFO" additivity="false">
        <appender-ref ref="CONFIG_AUDIT_FILE"/>
    </logger>

    <!-- AUDIT logger used by AuditLogAspect for security-sensitive operations. -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <!-- Silence Tomcat's "Exception Processing ErrorPage" stack trace when the
         underlying cause is just a ClientAbortException / Broken pipe — i.e. the
         browser closed the socket before the response finished writing (mostly
         caused by the webcam <img> swapping its src to trigger a refresh, which
         cancels the in-flight image request). The exception is benign; logging
         it at ERROR drowns the real errors in noise. WARN keeps it visible at
         a glance without the stack trace clutter at INFO level. -->
    <logger name="org.apache.catalina.core.ContainerBase.[Tomcat].[localhost]" level="WARN"/>

    <!-- Silence CookieTheftException stack traces raised by Spring Security's remember-me
         filter. Two concurrent requests carrying the same remember-me cookie (typical on
         SPA/PWA boot) hit token rotation: the second one arrives with the old token and
         Spring flags it as theft. It's a false positive here — the user is just bounced
         back to the login screen. The exception bubbles up to the dispatcher servlet
         which logs it at ERROR. Setting this logger to OFF removes the noise; genuine
         controller errors are still captured by GlobalExceptionHandler on its own logger. -->
    <logger name="org.apache.catalina.core.ContainerBase.[Tomcat].[localhost].[/].[dispatcherServlet]" level="OFF"/>

    <!-- Default root: keep Spring Boot's INFO console behaviour + write to spring.log. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
