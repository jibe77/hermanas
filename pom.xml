<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>org.jibe77</groupId>
	<artifactId>hermanas</artifactId>
	<version>0.9.2</version>
	<packaging>jar</packaging>
	<name>hermanas</name>
	<description>Chicken coop automation</description>

	<!-- verify updates before each release with display-dependency-updates -->
	<properties>
		<java.version>25</java.version>
		<!-- pi4j 4.x avec plugin FFM (Foreign Function & Memory API, Java 22+) -->
		<pi4j.version>4.0.2</pi4j.version>
		<mariadb-java-client.version>3.5.9</mariadb-java-client.version>
		<!-- springdoc 3.x : ligne alignée sur Spring Boot 4. La 1.x était SB 2
		     et la 2.x SB 3 — les deux tiraient Jackson 2 en doublon de la
		     Jackson 3 de SB 4. -->
		<springdoc-openapi.version>3.0.3</springdoc-openapi.version>
		<lib-sunrise-sunset.version>1.1.2</lib-sunrise-sunset.version>
		<commons-io.version>2.22.0</commons-io.version>
		<!-- Override the Spring Boot 2.7 BOM (3.12.0) — 3.20.0 stays Java 8
		     compatible per its pom, so it survives the Pi Zero / Java 11
		     constraint. Picks up minor API additions + CVE fixes accumulated
		     since 2021. -->
		<commons-lang3.version>3.20.0</commons-lang3.version>
		<sockjs-client.version>1.5.1</sockjs-client.version>
		<stomp-websocket.version>2.3.4</stomp-websocket.version>
		<jquery.version>3.7.1</jquery.version>

		<bootstrap.version>5.3.8</bootstrap.version>
		<web-push.version>5.1.2</web-push.version>
        <!-- 0.8.15+ requis : les versions <= 0.8.12 ne savent pas instrumenter
             le bytecode Java 25 (IllegalClassFormatException à chaque classe). -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!--
            CycloneDX SBOM plugin — emits target/bom.json + target/bom.xml at every
            `mvn package`. 2.9.2 is the latest release; there is no 3.x line.
            (The former Java 11 constraint no longer applies since the Java 25 move.)
            Note: the "Unknown keyword meta:enum / deprecated" warnings at build time
            come from the bundled JSON-schema validator, which predates those
            CycloneDX 1.6 keywords. Cosmetic only — the SBOM itself is valid.
        -->
        <cyclonedx-maven-plugin.version>2.9.2</cyclonedx-maven-plugin.version>

		<!-- Frontend build (Angular) -->
		<frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
		<node.version>v24.17.0</node.version>
		<npm.version>11.13.0</npm.version>
		<frontend.src.dir>${project.basedir}/frontend</frontend.src.dir>
		<frontend.build.dir>${frontend.src.dir}/dist/hermanas-client</frontend.build.dir>
	</properties>

	<dependencies>
		<!-- include Pi4J Core -->
		<dependency>
			<groupId>com.pi4j</groupId>
			<artifactId>pi4j-core</artifactId>
			<version>${pi4j.version}</version>
		</dependency>

		<!-- Pi4J plugin FFM : accès GPIO via Foreign Function & Memory API (Java 22+),
		     parle directement au kernel via chardev /dev/gpiochip0. Remplace pigpio
		     (archivé 2021, retiré de Trixie) et libgpiod (déprécié dans pi4j 4.1). -->
		<dependency>
			<groupId>com.pi4j</groupId>
			<artifactId>pi4j-plugin-ffm</artifactId>
			<version>${pi4j.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
			Implémente /actuator/prometheus, que application.properties expose déjà
			via management.endpoints.web.exposure.include. Sans cette dépendance
			l'endpoint renvoie 404 et les métriques de HermanasMetrics (porte,
			capteurs, caméra) ne sont scrapables par personne — node-exporter ne
			couvre que le système. Version gérée par le BOM Spring Boot.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-quartz</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Spring Boot 4 : RestTemplateBuilder / RestClient.Builder ne sont plus
		     fournis par spring-boot-starter-web, il faut ce starter dédié. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-messaging</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.junit.vintage</groupId>
					<artifactId>junit-vintage-engine</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Spring Boot 4 : l'infra de test est modularisée. @DataJpaTest et
		     @WebMvcTest ne sont plus dans spring-boot-test-autoconfigure mais
		     dans des modules spring-boot-<techno>-test dédiés. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
			<version>${mariadb-java-client.version}</version>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
		</dependency>
		<!-- Spring Boot 4 : spring-retry n'est plus dans le BOM, version fixée manuellement. -->
		<dependency>
			<groupId>org.springframework.retry</groupId>
			<artifactId>spring-retry</artifactId>
			<version>2.0.9</version>
		</dependency>
		<!-- Swagger UI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc-openapi.version}</version>
		</dependency>

		<!-- compute sunset and sunrise hour for the current day -->
		<!-- for more information : https://github.com/caarmen/SunriseSunset -->
		<dependency>
			<groupId>ca.rmen</groupId>
			<artifactId>lib-sunrise-sunset</artifactId>
			<version>${lib-sunrise-sunset.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>${commons-io.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>${commons-lang3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>webjars-locator-core</artifactId>
			<version>0.59</version>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>sockjs-client</artifactId>
			<version>${sockjs-client.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>stomp-websocket</artifactId>
			<version>${stomp-websocket.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>bootstrap</artifactId>
			<version>${bootstrap.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>jquery</artifactId>
			<version>${jquery.version}</version>
		</dependency>

		<!-- Spring Security Test -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Resilience4j : l'artifactId encode la ligne Spring Boot ciblée, et le
		     module refuse de démarrer si elle ne correspond pas — SpringBoot3Verifier
		     lève "Module ... is only compatible with Spring Boot 3.x" au lancement.
		     Un -spring-boot4 existe bien, en 2.4.0 également. -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot4</artifactId>
			<version>2.4.0</version>
		</dependency>
		<!-- Spring Boot 4 : spring-boot-starter-aop a été renommé spring-boot-starter-aspectj. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<!-- Web Push (VAPID) for PWA notifications. 5.1.x is Java 8+. The two
		     deps below are runtime-only in web-push's POM but we touch them at
		     compile time (BouncyCastleProvider for security setup, HttpResponse
		     as the return type of PushService.send), so we need them at compile
		     scope as well. -->
		<dependency>
			<groupId>nl.martijndwars</groupId>
			<artifactId>web-push</artifactId>
			<version>${web-push.version}</version>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk15on</artifactId>
			<version>1.70</version>
		</dependency>
		<!-- Apache HttpComponents v4 : aligné sur httpasyncclient 4.1.5 tiré par
		     web-push 5.1.2 (qui expose HttpResponse dans son API publique).
		     Spring Boot 3 a retiré httpclient (v4) de son BOM (migration vers
		     httpclient5), il faut donc fixer la version manuellement. -->
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>4.5.14</version>
		</dependency>
		<dependency>
			<groupId>org.bitbucket.b_c</groupId>
			<artifactId>jose4j</artifactId>
			<version>0.9.6</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				fork=true : contourne un bug de l'API javax.tools (compilation
				in-process via plexus-compiler-javac) qui plante avec
				"Fatal error compiling: Cannot load from object array because
				'this.hashes' is null" sur ce projet.
				En mode forké, javac tourne dans un process séparé et compile
				sans problème (vérifié : javac en direct avec release 25 passe).
				Voir maven-compiler-plugin issue 554.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<fork>true</fork>
				</configuration>
			</plugin>
			<!--
				Spring Boot 4 a retiré l'option <executable>true</executable> qui
				préfixait le JAR d'un script de lancement (./hermanas.jar). Sans
				impact ici : Hermanas.sh démarre le service via `java -jar`.
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-maven-plugin.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>image_processing</excludedGroups>
					<!--
						Mockito s'auto-attache comme agent Java pour son inline mock-maker,
						ce que le JDK interdira par défaut dans une prochaine version
						("Dynamic loading of agents will be disallowed"). On le déclare
						explicitement en -javaagent : le chemin du JAR est fourni par
						dependency:properties, lié à la phase initialize ci-dessous.
						@{argLine} préserve l'argLine posée par l'agent JaCoCo.
					-->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>resolve-dependency-paths</id>
						<phase>initialize</phase>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
				CycloneDX SBOM generation. Produces target/bom.json and target/bom.xml
				during `mvn package`, listing every resolved dependency with its
				version, license and PURL. The makeAggregateBom goal walks the runtime
				+ compile scopes only — we don't want test-scope clutter in the
				security inventory.
				The file is copied into the JAR under META-INF/sbom/ so a downstream
				operator can extract it without rebuilding (jar tf hermanas.jar | grep bom).
			-->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<version>${cyclonedx-maven-plugin.version}</version>
				<executions>
					<!--
						Le plugin déclare sa propre exécution 'default' liée au cycle de
						vie. Sans cette neutralisation elle s'ajoute à 'build-sbom'
						ci-dessous et produit un second SBOM JSON identique
						(application.cdx.json en plus de bom.json), soit ~500 Ko
						dupliqués dans le JAR.
					-->
					<execution>
						<id>default</id>
						<phase>none</phase>
					</execution>
					<execution>
						<id>build-sbom</id>
						<phase>package</phase>
						<goals>
							<goal>makeAggregateBom</goal>
						</goals>
						<configuration>
							<outputFormat>all</outputFormat>
							<schemaVersion>1.5</schemaVersion>
							<includeBomSerialNumber>true</includeBomSerialNumber>
							<includeCompileScope>true</includeCompileScope>
							<includeRuntimeScope>true</includeRuntimeScope>
							<includeTestScope>false</includeTestScope>
							<includeProvidedScope>false</includeProvidedScope>
							<includeSystemScope>false</includeSystemScope>
							<outputDirectory>${project.build.outputDirectory}/META-INF/sbom</outputDirectory>
							<outputName>bom</outputName>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Builds the Angular frontend and bundles it into the JAR under static/.
			Active by default. Skip with: mvn package -P!with-frontend
			The npm build is bound to the `package` phase only — `mvn test` / `mvn compile`
			do not trigger it.
		-->
		<profile>
			<id>with-frontend</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>${frontend-maven-plugin.version}</version>
						<configuration>
							<workingDirectory>${frontend.src.dir}</workingDirectory>
							<installDirectory>${project.build.directory}</installDirectory>
						</configuration>
						<executions>
							<execution>
								<id>install-node-and-npm</id>
								<goals>
									<goal>install-node-and-npm</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<nodeVersion>${node.version}</nodeVersion>
									<npmVersion>${npm.version}</npmVersion>
								</configuration>
							</execution>
							<execution>
								<id>npm-install</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>ci</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm-build</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>run build</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-frontend-to-static</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
									<resources>
										<resource>
											<directory>${frontend.build.dir}</directory>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<!--repositories>
		<repository>
			<id>caarmen-repo</id>
			<url>https://dl.bintray.com/caarmen/maven/</url>
		</repository>
	</repositories-->

	<repositories>
		<repository>
			<id>central</id>
			<url>https://repo.maven.apache.org/maven2</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>
</project>
