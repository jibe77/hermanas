sb-layout-auth
    .container
        .card.login-card
            .card-body
                h4.card-title.text-center(i18n='@@signin') Connexion
                form([formGroup]='loginForm', (ngSubmit)='onSubmit()', novalidate)
                    .form-group.mb-3
                        label(for='username', i18n='@@username') Identifiant
                        input#username.form-control(
                            type='text',
                            formControlName='username',
                            autocomplete='username',
                            data-cy='loginUsername',
                            required
                        )
                    .form-group.mb-3
                        label(for='password', i18n='@@password') Mot de passe
                        input#password.form-control(
                            type='password',
                            formControlName='password',
                            autocomplete='current-password',
                            data-cy='loginPassword',
                            required
                        )
                    .alert.alert-danger(*ngIf='errorMessage', data-cy='loginError') {{ errorMessage }}
                    button.btn.btn-primary.w-100(
                        type='submit',
                        data-cy='loginSubmit',
                        [disabled]='loginForm.invalid || submitting'
                    )
                        span(*ngIf='!submitting', i18n='@@signin') Se connecter
                        span(*ngIf='submitting', i18n='@@signinInProgress') Connexion…
