{
    "name": "hermanas-client",
    "version": "0.9.3",
    "scripts": {
        "build": "npm run ng -- build --configuration production --localize --stats-json && npm run build:index && npm run build:version",
        "build:debug": "npm run ng -- build --configuration production --source-map --stats-json && npm run build:index && npm run build:version",
        "build:version": "node scripts/version.js",
        "build:index": "node scripts/index.js",
        "bundle-report": "webpack-bundle-analyzer dist/hermanas-client/stats-es2015.json",
        "docker:build": "node scripts/docker/docker-build.js",
        "docker:run": "node scripts/docker/docker-run.js",
        "e2e": "playwright test",
        "e2e:headed": "playwright test --headed",
        "e2e:ui": "playwright test --ui",
        "e2e:debug": "playwright test --debug",
        "e2e:report": "playwright show-report",
        "lint:fix": "npm run ng -- lint --fix",
        "lint": "npm run ng -- lint",
        "ng": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048\" ./node_modules/.bin/ng",
        "serve": "./node_modules/.bin/static-server dist/hermanas-client",
        "start": "node scripts/start.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "i18n": "ng extract-i18n --output-path src/locale --out-file messages.xlf"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "~22.1.0",
        "@angular/cdk": "^22.1.0",
        "@angular/common": "~22.1.0",
        "@angular/compiler": "~22.1.0",
        "@angular/core": "~22.1.0",
        "@angular/forms": "~22.1.0",
        "@angular/material": "^22.1.0",
        "@angular/platform-browser": "~22.1.0",
        "@angular/platform-browser-dynamic": "~22.1.0",
        "@angular/router": "~22.1.0",
        "@angular/service-worker": "~22.1.0",
        "@fortawesome/angular-fontawesome": "^5.1.0",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@ng-bootstrap/ng-bootstrap": "^21.0.0",
        "@popperjs/core": "^2.11.8",
        "@stomp/rx-stomp": "~2.4.0",
        "@stomp/stompjs": "^7.3.0",
        "flag-icon-css": "^3.5.0",
        "rxjs": "~7.8.2",
        "tslib": "2.8.1",
        "zone.js": "^0.16.2"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "^2.6.4",
        "@analogjs/vitest-angular": "^2.6.4",
        "@angular-eslint/builder": "^22.1.0",
        "@angular-eslint/eslint-plugin": "^22.1.0",
        "@angular-eslint/eslint-plugin-template": "^22.1.0",
        "@angular-eslint/schematics": "^22.1.0",
        "@angular-eslint/template-parser": "^22.1.0",
        "@angular/build": "^22.1.2",
        "@angular/cli": "~22.1.2",
        "@angular/compiler-cli": "~22.1.0",
        "@angular/language-service": "~22.1.0",
        "@angular/localize": "~22.1.0",
        "@inip/static-server": "1.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^24.13.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitest/coverage-v8": "^4.1.10",
        "bootstrap": "^5.3.8",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "shelljs": "^0.10.0",
        "typescript": "~6.0.3",
        "vitest": "^4.1.10",
        "webpack-bundle-analyzer": "^5.3.1"
    },
    "browser": {
        "crpyto": false
    }
}
