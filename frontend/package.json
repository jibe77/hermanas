{
  "name": "hermanas-client",
  "version": "0.8.0",
  "scripts": {
    "build": "npm run ng -- build --configuration production --localize --build-optimizer=true --stats-json && npm run build:index && npm run build:version",
    "build:debug": "npm run ng -- build --configuration production --source-map --build-optimizer=true --stats-json && npm run build:index && npm run build:version",
    "build:version": "node scripts/version.js",
    "build:index": "node scripts/index.js",
    "bundle-report": "webpack-bundle-analyzer dist/hermanas-client/stats-es2015.json",
    "docker:build": "node scripts/docker/docker-build.js",
    "docker:run": "node scripts/docker/docker-run.js",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "generate:component": "./node_modules/.bin/ng generate @sbpro/ng:component",
    "generate:directive": "./node_modules/.bin/ng generate @sbpro/ng:directive",
    "generate:module": "./node_modules/.bin/ng generate @sbpro/ng:module",
    "generate:service": "./node_modules/.bin/ng generate @sbpro/ng:service",
    "lint:fix": "npm run ng -- lint --fix",
    "lint": "npm run ng -- lint",
    "ng": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048\" ./node_modules/.bin/ng",
    "serve": "./node_modules/.bin/static-server dist/hermanas-client",
    "start": "node scripts/start.js",
    "test": "npm run ng -- test",
    "i18n": "ng extract-i18n --output-path src/locale --out-file messages.xlf"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~18.2.14",
    "@angular/cdk": "~18.2.0",
    "@angular/common": "~18.2.14",
    "@angular/compiler": "~18.2.14",
    "@angular/core": "~18.2.14",
    "@angular/forms": "~18.2.14",
    "@angular/material": "~18.2.0",
    "@angular/platform-browser": "~18.2.14",
    "@angular/platform-browser-dynamic": "~18.2.14",
    "@angular/router": "~18.2.14",
    "@angular/service-worker": "~18.2.14",
    "@fortawesome/angular-fontawesome": "^0.13.0",
    "@fortawesome/fontawesome-svg-core": "~6.5.0",
    "@fortawesome/free-brands-svg-icons": "~6.5.0",
    "@fortawesome/free-regular-svg-icons": "~6.5.0",
    "@fortawesome/free-solid-svg-icons": "~6.5.0",
    "@ng-bootstrap/ng-bootstrap": "^13.1.1",
    "@popperjs/core": "^2.11.8",
    "@stomp/rx-stomp": "~2.0.0",
    "@stomp/stompjs": "^7.2.1",
    "@types/sockjs-client": "^1.5.0",
    "chart.js": "^3.6.2",
    "flag-icon-css": "^3.5.0",
    "object-hash": "2.1.1",
    "rxjs": "~7.8.1",
    "tslib": "2.2.0",
    "uuid": "8.3.2",
    "webpack-bundle-analyzer": "4.4.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.12",
    "@angular-eslint/builder": "^16.3.1",
    "@angular-eslint/eslint-plugin": "^16.3.1",
    "@angular-eslint/eslint-plugin-template": "^16.3.1",
    "@angular-eslint/schematics": "^16.3.1",
    "@angular-eslint/template-parser": "^16.3.1",
    "@angular/cli": "~18.2.21",
    "@angular/compiler-cli": "~18.2.14",
    "@angular/language-service": "~18.2.14",
    "@angular/localize": "~18.2.14",
    "@inip/static-server": "1.0.1",
    "@playwright/test": "^1.57.0",
    "@sbpro/ng": "1.4.2",
    "@types/chart.js": "^2.9.34",
    "@types/jasmine": "3.6.9",
    "@types/jasminewd2": "2.0.8",
    "@types/node": "14.14.37",
    "@types/object-hash": "2.1.0",
    "@types/uuid": "8.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "bootstrap": "5.3.3",
    "cross-env": "7.0.3",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "graphql": "^15.5.0",
    "jasmine-core": "3.7.1",
    "karma": "6.3.2",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "4.0.1",
    "karma-jasmine-html-reporter": "1.5.4",
    "prettier": "2.2.1",
    "shelljs": "0.8.4",
    "ts-node": "9.1.1",
    "typescript": "~5.4.5"
  },
  "browser": {
    "crpyto": false
  }
}