{
  "name": "hermanas-client",
  "version": "0.8.1",
  "scripts": {
    "build": "npm run ng -- build --configuration production --localize --build-optimizer=true --stats-json && npm run build:index && npm run build:version",
    "build:debug": "npm run ng -- build --configuration production --source-map --build-optimizer=true --stats-json && npm run build:index && npm run build:version",
    "build:version": "node scripts/version.js",
    "build:index": "node scripts/index.js",
    "bundle-report": "webpack-bundle-analyzer dist/hermanas-client/stats-es2015.json",
    "docker:build": "node scripts/docker/docker-build.js",
    "docker:run": "node scripts/docker/docker-run.js",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "lint:fix": "npm run ng -- lint --fix",
    "lint": "npm run ng -- lint",
    "ng": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048\" ./node_modules/.bin/ng",
    "serve": "./node_modules/.bin/static-server dist/hermanas-client",
    "start": "node scripts/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n": "ng extract-i18n --output-path src/locale --out-file messages.xlf"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "~21.2.17",
    "@angular/compiler": "~21.2.17",
    "@angular/core": "~21.2.17",
    "@angular/forms": "~21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "~21.2.17",
    "@angular/platform-browser-dynamic": "~21.2.17",
    "@angular/router": "~21.2.17",
    "@angular/service-worker": "~21.2.17",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "@stomp/rx-stomp": "~2.4.0",
    "@stomp/stompjs": "^7.2.1",
    "flag-icon-css": "^3.5.0",
    "rxjs": "~7.8.1",
    "tslib": "2.2.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@analogjs/vitest-angular": "^2.5.2",
    "@angular-devkit/build-angular": "~21.2.15",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "~21.2.15",
    "@angular/compiler-cli": "~21.2.17",
    "@angular/language-service": "~21.2.17",
    "@angular/localize": "~21.2.17",
    "@inip/static-server": "1.0.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "bootstrap": "^5.3.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "shelljs": "^0.10.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8",
    "webpack-bundle-analyzer": "^5.3.0"
  },
  "browser": {
    "crpyto": false
  }
}
